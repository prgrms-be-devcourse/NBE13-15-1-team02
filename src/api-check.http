#에러발생시 테이블 drop 및 초기화
### ============================================================
#drop table order_item;
#drop table `order`;
#drop table menu;
#drop table category;
### ============================================================


@baseUrl = http://127.0.0.1:8080
@categoryId = 6
@menuId = 1




### A01 카테고리 목록
###
GET http://{{baseUrl}}/api/v1/categories
### A02 카테고리 상세
###
GET http://localhost:8080/api/v1/categories/2
### A03 카테고리 등록
###
POST http://localhost:8080/api/v1/categories
Content-Type: application/json

{
  "name": "TEST"
}

### A04 카테고리 수정
###
PUT http://localhost:8080/api/v1/categories/{{categoryId}}
Content-Type: application/json

{
  "name": "Test Bean"
}

### A05 카테고리 삭제
###
DELETE http://localhost:8080/api/v1/categories/{{categoryId}}

### A06 전체메뉴
###
GET http://localhost:8080/api/v1/menus

### A07 메뉴 상세
###
GET http://localhost:8080/api/v1/menus/{{menuId}}?
    keyword={{$random.alphanumeric(8)}}

### A08 메뉴 등록
###
GET http://localhost:8080/api/v1/menus/{{menuId}}?
    keyword={{$random.alphanumeric(8)}}

### A09 메뉴 일반 수정
###
PUT http://localhost:8080/api/v1/menus/{{menuId}}?
    keyword={{$random.alphanumeric(8)}}
Content-Type: application/json

{
  "categoryId": 1,
  "name": "Test name Bean",
  "price": 99999,
  "description": "Test description Bean"
}

### A10 메뉴 삭제
###
DELETE http://localhost:8080/api/v1/menus/{{menuId}}?
    keyword={{$random.alphanumeric(8)}}

### A11 주문 접수
###
POST http://localhost:8080/api/v1/orders?
    email={{$random.alphanumeric(8)}}
Content-Type: application/json

{
  "email": "KDT_TEST@test.com",
  "address": "Test address",
  "postcode": 12345,
  "items": [
    "menuId" : 7,
    "quantity" : 1
  ]
}
### A12 이메일별 주문
###
GET http://localhost:8080/api/v1/orders?
    email={{$random.alphanumeric(8)}}