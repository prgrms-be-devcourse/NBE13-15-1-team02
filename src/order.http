### ============================================================
### 주문 API 확인 (A11~A14, A16~A18, A22~A24)
### 실행 순서: 0 → 1 → 2 → ... 위에서 아래로 순서대로 (앞 요청의 id를 뒤 요청이 사용)
### 준비 데이터: 메뉴 id 1~4 (5000 / 7000 / 9000 / 11000원, 모두 판매 중) - menu.http 시드와 동일
### 변수: baseUrl만 고정. email·today·orderId 등은 실행 중 자동 저장
### 주의: 주문은 DB에 계속 쌓입니다. 실행할 때마다 새 이메일(타임스탬프)을 만들어 서로 안 겹치게 합니다.
### 오류 우선순위: 400 → 404 → 409
### ============================================================


@baseUrl = http://127.0.0.1:8080
@contentType = application/json


### 0. 준비: 변수 세팅 + 메뉴 시드 확인
# 이메일 3개: E1(주 시나리오), E2(주소 규칙), E3(전부 취소한 고객)
# today = 서울 기준 오늘 날짜 (통계 조회용)
< {%
    const ts = Date.now();
    client.global.set("email", "kdt" + ts + "a@test.com");
    client.global.set("email2", "kdt" + ts + "b@test.com");
    client.global.set("email3", "kdt" + ts + "c@test.com");
    client.global.set("today", new Date(Date.now() + 9 * 3600 * 1000).toISOString().slice(0, 10));
%}
GET {{baseUrl}}/api/v1/menus

> {%
    client.test("200", () => client.assert(response.status === 200));
    client.test("메뉴 id 1~4 존재", () => client.assert(
        [1, 2, 3, 4].every(id => response.body.some(m => m.id === id && m.available === true))
    ));
%}


### ============================================================
### A11 주문 접수 POST /api/v1/orders
### ============================================================

### 1. 주문 접수 정상 (E1, 주소 앞뒤 공백 → trim, 클라이언트가 보낸 가격·상태 등은 무시)
# 기대: 201, status=PLACED, cancelledAt=null, memo="", totalAmount=17000 (5000×2 + 7000×1)
# address는 공백 제거 후 저장 / totalAmount·status·shippingDate·createdAt은 요청값을 쓰지 않음
POST {{baseUrl}}/api/v1/orders
Content-Type: {{contentType}}

{
  "email": "{{email}}",
  "address": "  서울시 강남구 테헤란로 1  ",
  "postcode": "06236",
  "items": [
    {"menuId": 1, "quantity": 2},
    {"menuId": 2, "quantity": 1}
  ],
  "totalAmount": 1,
  "status": "CANCELLED",
  "shippingDate": "2000-01-01",
  "createdAt": "2000-01-01T00:00:00+09:00"
}

> {%
    client.global.set("orderId", response.body.id);
    client.global.set("shippingDate", response.body.shippingDate);
    client.test("201 Created", () => client.assert(response.status === 201));
    client.test("status PLACED", () => client.assert(response.body.status === "PLACED"));
    client.test("cancelledAt null", () => client.assert(response.body.cancelledAt === null));
    client.test("memo 빈 문자열", () => client.assert(response.body.memo === ""));
    client.test("address trimmed", () => client.assert(response.body.address === "서울시 강남구 테헤란로 1"));
    client.test("totalAmount 17000 (요청값 무시)", () => client.assert(response.body.totalAmount === 17000));
    client.test("shippingDate 요청값 무시", () => client.assert(response.body.shippingDate !== "2000-01-01"));
    client.test("createdAt +09:00", () => client.assert(response.body.createdAt.endsWith("+09:00")));
    client.test("items 2개 / 금액=단가×수량", () => {
        client.assert(response.body.items.length === 2);
        const i = response.body.items[0];
        client.assert(i.menuId === 1 && i.unitPrice === 5000 && i.quantity === 2 && i.lineAmount === 10000);
    });
%}


### 2. 같은 이메일·같은 주소로 한 번 더 주문 (E1, 배송 묶음에 합쳐질 주문)
# 기대: 201, totalAmount=32000 (5000×1 + 9000×3)
POST {{baseUrl}}/api/v1/orders
Content-Type: {{contentType}}

{
  "email": "{{email}}",
  "address": "서울시 강남구 테헤란로 1",
  "postcode": "06236",
  "items": [
    {"menuId": 1, "quantity": 1},
    {"menuId": 3, "quantity": 3}
  ]
}

> {%
    client.global.set("orderId2", response.body.id);
    client.test("201 Created", () => client.assert(response.status === 201));
    client.test("totalAmount 32000", () => client.assert(response.body.totalAmount === 32000));
    client.test("같은 배송일", () => client.assert(response.body.shippingDate === client.global.get("shippingDate")));
%}


### 3. 같은 이메일·배송일인데 주소가 다름
# 기대: 409 ADDRESS_MISMATCH (기존 PLACED 주문이 있으므로)
POST {{baseUrl}}/api/v1/orders
Content-Type: {{contentType}}

{
  "email": "{{email}}",
  "address": "부산시 해운대구 해운대로 1",
  "postcode": "48099",
  "items": [{"menuId": 1, "quantity": 1}]
}

> {%
    client.test("409", () => client.assert(response.status === 409));
    client.test("ADDRESS_MISMATCH", () => client.assert(response.body.code === "ADDRESS_MISMATCH"));
%}


### 4. 검증 실패: 이메일 형식 오류
# 기대: 400 VALIDATION_ERROR, fieldErrors에 email
POST {{baseUrl}}/api/v1/orders
Content-Type: {{contentType}}

{
  "email": "not-an-email",
  "address": "서울시 강남구",
  "postcode": "06236",
  "items": [{"menuId": 1, "quantity": 1}]
}

> {%
    client.test("400", () => client.assert(response.status === 400));
    client.test("VALIDATION_ERROR", () => client.assert(response.body.code === "VALIDATION_ERROR"));
    client.test("fieldErrors.email", () => client.assert("email" in response.body.fieldErrors));
%}


