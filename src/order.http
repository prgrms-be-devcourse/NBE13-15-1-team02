### ============================================================
### A14 배송 묶음 GET /api/v1/delivery-batches?shippingDate={shippingDate}
### ============================================================

### 22. 배송 묶음 (아직 취소 전)
# 기대: 200, E1의 묶음 1개: orderIds=[orderId, orderId2] 오름차순, orderCount=2
#       totalQuantity=7 (2+1+1+3), totalAmount=49000 (17000+32000)
#       items는 메뉴 ID 오름차순으로 합산: 메뉴1=3개, 메뉴2=1개, 메뉴3=3개
GET {{baseUrl}}/api/v1/delivery-batches?shippingDate={{shippingDate}}

> {%
    client.test("200", () => client.assert(response.status === 200));
    const b = response.body.find(x => x.email === client.global.get("email"));
    client.test("E1 묶음 존재", () => client.assert(b !== undefined));
    client.test("orderIds 오름차순", () => client.assert(
        JSON.stringify(b.orderIds) === JSON.stringify([client.global.get("orderId"), client.global.get("orderId2")])
    ));
    client.test("orderCount 2", () => client.assert(b.orderCount === 2));
    client.test("totalQuantity 7", () => client.assert(b.totalQuantity === 7));
    client.test("totalAmount 49000", () => client.assert(b.totalAmount === 49000));
    client.test("items 합산 (메뉴 1=3, 2=1, 3=3)", () => client.assert(
        JSON.stringify(b.items.map(i => [i.menuId, i.quantity])) === JSON.stringify([[1, 3], [2, 1], [3, 3]])
    ));
    client.test("묶음이 이메일 오름차순", () => {
        const emails = response.body.map(x => x.email);
        client.assert(JSON.stringify(emails) === JSON.stringify([...emails].sort()));
    });
%}


