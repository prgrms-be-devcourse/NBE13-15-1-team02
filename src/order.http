### 55. 오늘 고객 통계
# 기대: 200, 이메일 오름차순
#   E1: orderCount=4, placed=3, cancelled=1, totalQuantity=10, totalAmount=66000
#   E3: orderCount=1, placed=0, cancelled=1, totalQuantity=0, totalAmount=0  (전부 취소한 고객도 포함)
GET {{baseUrl}}/api/v1/statistics/customers?date={{today}}

> {%
    client.test("200", () => client.assert(response.status === 200));
    client.test("이메일 오름차순", () => {
        const emails = response.body.map(c => c.email);
        client.assert(JSON.stringify(emails) === JSON.stringify([...emails].sort()));
    });
    const e1 = response.body.find(c => c.email === client.global.get("email"));
    const e3 = response.body.find(c => c.email === client.global.get("email3"));
    client.test("E1 집계", () => client.assert(
        e1 !== undefined && e1.orderCount === 4 && e1.placedOrderCount === 3 && e1.cancelledOrderCount === 1
        && e1.totalQuantity === 10 && e1.totalAmount === 66000
    ));
    client.test("E3 (전부 취소) 포함, PLACED 수량·금액 0", () => client.assert(
        e3 !== undefined && e3.orderCount === 1 && e3.placedOrderCount === 0 && e3.cancelledOrderCount === 1
        && e3.totalQuantity === 0 && e3.totalAmount === 0
    ));
    client.test("date 필드", () => client.assert(response.body.every(c => c.date === client.global.get("today"))));
%}


