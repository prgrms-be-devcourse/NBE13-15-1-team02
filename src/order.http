### ============================================================
### A17 접수일별 주문 통계 GET /api/v1/statistics/orders?date={date}
### date는 배송일이 아니라 서울 기준 접수일. 전체 주문 수는 취소 포함, 수량·금액은 PLACED만
### ============================================================

### 48. 오늘 접수 주문 통계
# 기대: 200, date=오늘 / orderCount = placedOrderCount + cancelledOrderCount
#       cancelledOrderCount ≥ 3 (E1의 orderId2, E2, E3)  /  placedOrderCount ≥ 5
# (오늘 다른 주문도 DB에 있을 수 있어 정확한 개수 대신 관계로 확인)
GET {{baseUrl}}/api/v1/statistics/orders?date={{today}}

> {%
    client.test("200", () => client.assert(response.status === 200));
    client.test("date 일치", () => client.assert(response.body.date === client.global.get("today")));
    client.test("fields", () => client.assert(
        ["date", "orderCount", "placedOrderCount", "cancelledOrderCount", "totalQuantity", "totalAmount"].every(k => k in response.body)
    ));
    client.test("전체 = PLACED + CANCELLED", () => client.assert(
        response.body.orderCount === response.body.placedOrderCount + response.body.cancelledOrderCount
    ));
    client.test("취소 3건 이상 / PLACED 5건 이상", () => client.assert(
        response.body.cancelledOrderCount >= 3 && response.body.placedOrderCount >= 5
    ));
    client.test("수량·금액은 PLACED 기준 (양수)", () => client.assert(response.body.totalQuantity > 0 && response.body.totalAmount > 0));
%}


