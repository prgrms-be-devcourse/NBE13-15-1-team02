### ============================================================
### A18 접수일별 메뉴 통계 GET /api/v1/statistics/menus?date={date}
### ============================================================

### 52. 오늘 메뉴 통계
# 기대: 200, 배열 / 메뉴 ID → 단가 → 메뉴명 오름차순 / 각 항목에 menuId·menuName·unitPrice·totalQuantity·totalAmount
#       totalAmount = unitPrice × totalQuantity (PLACED만 집계, 취소 주문은 제외)
GET {{baseUrl}}/api/v1/statistics/menus?date={{today}}

> {%
    client.test("200", () => client.assert(response.status === 200));
    client.test("배열이고 비어 있지 않음", () => client.assert(Array.isArray(response.body) && response.body.length > 0));
    client.test("fields", () => client.assert(
        ["menuId", "menuName", "unitPrice", "totalQuantity", "totalAmount"].every(k => k in response.body[0])
    ));
    client.test("금액 = 단가 × 수량", () => client.assert(
        response.body.every(m => m.totalAmount === m.unitPrice * m.totalQuantity)
    ));
    client.test("메뉴 ID → 단가 → 메뉴명 오름차순", () => {
        const ok = response.body.every((m, i) => {
            if (i === 0) return true;
            const p = response.body[i - 1];
            if (p.menuId !== m.menuId) return p.menuId < m.menuId;
            if (p.unitPrice !== m.unitPrice) return p.unitPrice < m.unitPrice;
            return p.menuName <= m.menuName;
        });
        client.assert(ok);
    });
%}


