### 27. 메모 수정 (메모에 주소를 적어도 실제 배송지는 바뀌지 않음)
# 기대: 200, memo만 바뀜 / address·postcode·totalAmount·status 그대로
PUT {{baseUrl}}/api/v1/orders/{{orderId}}/memo
Content-Type: {{contentType}}

{
  "memo": "배송지를 부산시 해운대구로 바꿔 주세요"
}

> {%
    client.test("200", () => client.assert(response.status === 200));
    client.test("memo 변경", () => client.assert(response.body.memo === "배송지를 부산시 해운대구로 바꿔 주세요"));
    client.test("address 유지", () => client.assert(response.body.address === "서울시 강남구 테헤란로 1"));
    client.test("totalAmount·status 유지", () => client.assert(response.body.totalAmount === 17000 && response.body.status === "PLACED"));
%}


