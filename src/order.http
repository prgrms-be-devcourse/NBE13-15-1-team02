    client.test("E1 묶음 존재", () => client.assert(b !== undefined));
    client.test("취소 주문 제외 + orderIds 오름차순", () => client.assert(
        JSON.stringify(b.orderIds) ===
        JSON.stringify([client.global.get("orderId"), client.global.get("reorderId"), client.global.get("reorderId2")])
    ));
    client.test("orderCount 3", () => client.assert(b.orderCount === 3));
    client.test("totalQuantity 10", () => client.assert(b.totalQuantity === 10));
    client.test("totalAmount 66000", () => client.assert(b.totalAmount === 66000));
    client.test("items 합산 (메뉴 1=5, 2=2, 3=3)", () => client.assert(
        JSON.stringify(b.items.map(i => [i.menuId, i.quantity])) === JSON.stringify([[1, 5], [2, 2], [3, 3]])
    ));
%}


