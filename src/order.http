### ============================================================
### A23 재주문 POST /api/v1/orders/{orderId}/reorder  (본문 없음)
### ============================================================

### 31. 재주문 (메모가 있는 원본으로)
# 기대: 201, 새 id / status=PLACED / cancelledAt=null / memo="" (원본 메모는 복사하지 않음)
#       이메일·주소·우편번호·메뉴·수량은 원본과 같음 / 배송일은 재주문 시각 기준
POST {{baseUrl}}/api/v1/orders/{{orderId}}/reorder

> {%
    client.global.set("reorderId", response.body.id);
    client.test("201 Created", () => client.assert(response.status === 201));
    client.test("새 id", () => client.assert(response.body.id !== client.global.get("orderId")));
    client.test("PLACED / cancelledAt null / memo 빈 문자열", () => client.assert(
        response.body.status === "PLACED" && response.body.cancelledAt === null && response.body.memo === ""
    ));
    client.test("원본과 같은 이메일·주소", () => client.assert(
        response.body.email === client.global.get("email") && response.body.address === "서울시 강남구 테헤란로 1"
    ));
    client.test("항목 같음 (메뉴1×2, 메뉴2×1)", () => client.assert(
        JSON.stringify(response.body.items.map(i => [i.menuId, i.quantity])) === JSON.stringify([[1, 2], [2, 1]])
    ));
    client.test("totalAmount 17000", () => client.assert(response.body.totalAmount === 17000));
%}


