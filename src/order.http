### 14. 이메일별 주문 목록
# 기대: 200, E1 주문 2건, 접수 시각 내림차순 → 같으면 ID 내림차순 (orderId2가 먼저)
GET {{baseUrl}}/api/v1/orders?email={{email}}

> {%
    client.test("200", () => client.assert(response.status === 200));
    client.test("2건", () => client.assert(response.body.length === 2));
    client.test("최신(ID 큰 것)이 먼저", () => client.assert(response.body[0].id === client.global.get("orderId2")));
    client.test("fields", () => client.assert(
        ["id", "createdAt", "shippingDate", "totalAmount", "status"].every(k => k in response.body[0])
    ));
%}


